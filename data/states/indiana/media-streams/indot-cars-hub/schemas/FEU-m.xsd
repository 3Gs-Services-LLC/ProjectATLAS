<?xml version="1.0" encoding="UTF-8"?>

<xs:schema targetNamespace="http://www.crc-corp.com/schemas/hub/feu-m"
           xmlns="http://www.crc-corp.com/schemas/hub/feu-m"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"

           elementFormDefault="unqualified"
           attributeFormDefault="unqualified"
           version="DRAFT">

   <xs:element name="full-event-update" type="FullEventUpdate"/>

   <!-- Descriptive Name: AdditionalText -->
   <xs:complexType name="AdditionalText">
      <xs:sequence>
         <xs:element name="description" type="Event-description"/>
         <!-- 3209 -->
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: DateTimeZone -->
   <xs:complexType name="DateTimeZone">
      <xs:sequence>
         <xs:element name="date" type="Time-local-date"/>
         <!-- 3398 -->
         <xs:element name="time" type="Time-local-time"/>
         <!-- 3397 -->
         <xs:element name="utc-offset" type="Time-utc-offset" minOccurs="0"/>
         <!-- 3376 -->
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: ElementDescription -->
   <xs:complexType name="ElementDescription">
      <xs:choice>
         <xs:element name="phrase" type="EventType"/>
         <xs:element name="additional-text" type="AdditionalText"/>
      </xs:choice>
   </xs:complexType>

   <!-- Descriptive Name: EventElementDetail -->
   <xs:complexType name="EventElementDetail">
      <xs:sequence>

         <xs:element name="element-id" type="Event-element-identifier"/>
         <!-- 3378 -->
         <xs:element name="descriptions">
            <xs:complexType>
               <xs:sequence minOccurs="0" maxOccurs="unbounded">
                  <xs:element name="description" type="ElementDescription"/>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
         <xs:element name="locations">
            <xs:complexType>
               <xs:sequence minOccurs="0" maxOccurs="unbounded">
                  <xs:element name="location" type="EventLocation"/>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
         <xs:element name="times" type="EventTimes"/>
         <xs:element name="source" type="EventSource" minOccurs="0"/>
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EventHeadline -->
   <xs:complexType name="EventHeadline">
      <xs:sequence>
         <xs:element name="headline" type="EventType"/>
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EventIndicator -->
   <xs:complexType name="EventIndicator">
      <xs:choice>
         <xs:element name="priority" type="Event-description-priority-level"/>
         <!-- 3301 -->
      </xs:choice>
   </xs:complexType>

   <!-- Descriptive Name: EventLocation -->
   <xs:complexType name="EventLocation">
      <xs:choice>
         <xs:element name="location-on-link" type="LinkLocation"/>
      </xs:choice>
   </xs:complexType>

   <!-- Descriptive Name: EventReference -->
   <xs:complexType name="EventReference">
      <xs:sequence>
         <xs:element name="event-id" type="Event-identifier"/>
         <!-- 3215 -->
         <xs:element name="update" type="Event-update"/>
         <!-- 3293 -->
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EventSource -->
   <xs:complexType name="EventSource">
      <xs:sequence>
         <xs:element name="source" type="OrganizationInformation" minOccurs="0"/>
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EventComments -->
   <xs:complexType name="EventComments">
      <xs:sequence>
         <xs:element name="notes-and-comments" type="Event-description-notes-and-comments"/>
         <!-- 3210 -->
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EventTimes -->
   <xs:complexType name="EventTimes">
      <xs:sequence>
         <xs:element name="update-time" type="DateTimeZone"/>
         <xs:element name="valid-period" type="ValidPeriod"/>
         <xs:element name="start-time" type="DateTimeZone" minOccurs="0"/>
         <xs:element name="active-periods" minOccurs="0">
            <xs:complexType>
               <xs:sequence minOccurs="0" maxOccurs="unbounded">
                  <xs:element name="active-period" type="ActivePeriod" />
               </xs:sequence>
            </xs:complexType>
         </xs:element>
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EventType -->
   <xs:complexType name="EventType">
      <xs:choice>
         <xs:element name="traffic-condition" type="Event-description-type-traffic-conditions"/>
         <!-- 3817 -->
         <xs:element name="incident" type="Event-description-type-incident"/>
         <!-- 3818 -->
         <xs:element name="closure" type="Event-description-type-closure"/>
         <!-- 3819 -->
         <xs:element name="roadwork" type="Event-description-type-roadwork"/>
         <!-- 3213 -->
         <xs:element name="obstruction" type="Event-description-type-obstruction"/>
         <!-- 3822 -->
         <xs:element name="delay" type="Event-description-type-delay-status-cancellation"/>
         <!-- 3830 -->
         <xs:element name="unusual-driving" type="Event-description-type-unusual-driving"/>
         <!-- 3831 -->
         <xs:element name="mobile-situation" type="Event-description-type-mobile-situation"/>
         <!-- 3832 -->
         <xs:element name="device-status" type="Event-description-type-device-status"/>
         <!-- 3833 -->
         <xs:element name="restriction" type="Link-restriction-class"/>
         <!-- 3025 -->
         <xs:element name="disaster" type="Event-description-type-disaster"/>
         <!-- 3880 -->
         <xs:element name="disturbance" type="Event-description-type-disturbances"/>
         <!-- 3884 -->
         <xs:element name="sporting-event" type="Event-description-type-sporting-events"/>
         <!-- 3886 -->
         <xs:element name="special-event" type="Event-description-type-special-event"/>
         <!-- 3214 -->
         <xs:element name="parking-information" type="Event-description-type-parking-information"/>
         <!-- 3835 -->
         <xs:element name="system-information" type="Event-description-type-system-information"/>
         <!-- 3836 -->
         <xs:element name="weather-condition" type="Event-description-type-weather-condition"/>
         <!-- 3299 -->
         <xs:element name="precipitation" type="Event-description-type-precipitation"/>
         <!-- 3825 -->
         <xs:element name="wind" type="Event-description-type-wind"/>
         <!-- 3826 -->
         <xs:element name="visibility-air-quality" type="Event-description-type-visibility-air-quality"/>
         <!-- 3827 -->
         <xs:element name="temperature" type="Event-description-type-temperature"/>
         <!-- 3828 -->
         <xs:element name="pavement-condition" type="Event-description-type-pavement-condition"/>
         <!-- 3298 -->
         <xs:element name="winter-driving-restriction" type="Event-description-type-winter-driving-restrictions"/>
         <!-- 3888 -->
         <xs:element name="winter-driving-index" type="Event-description-type-winter-driving-index"/>
         <!-- 3823 -->
         <xs:element name="dnu-cars-segment" type="Event-description-type-dnu-cars-segment"/>
         <xs:element name="dnu-cars-segment-ia" type="Event-description-type-dnu-cars-segment-ia"/>
         <xs:element name="nws-warning" type="Event-description-type-nws-warning"/>
         <xs:element name="ferries" type="Event-description-type-ferries"/>
         <xs:element name="activity" type="Event-description-type-activity"/>
         <xs:element name="waze" type="Event-description-type-waze"/>
         <xs:element name="mdss-conditions" type="Event-description-type-mdss-conditions"/>
         <xs:element name="co-imports-phrases" type="Event-description-type-co-imports-phrases"/>
         <xs:element name="cdot-oversize-overweight-restrctions" type="Event-description-type-cdot-oversize-overweight-restrictions"/>
         <xs:element name="cdot-road-conditions" type="Event-description-type-cdot-road-conditions"/>
      </xs:choice>
   </xs:complexType>

   <!-- Descriptive Name: FullEventUpdate -->
   <xs:complexType name="FullEventUpdate">
      <xs:sequence>
         <xs:element name="message-header" type="MessageHeader"/>
         <xs:element name="event-reference" type="EventReference"/>
         <xs:element name="event-indicators" minOccurs="0">
            <xs:complexType>
               <xs:sequence>
                  <xs:element name="event-indicator" type="EventIndicator" minOccurs="0" maxOccurs="unbounded"/>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
         <xs:element name="headline" type="EventHeadline"/>
         <xs:element name="details" minOccurs="0">
            <xs:complexType>
               <xs:sequence minOccurs="0" maxOccurs="unbounded">
                  <xs:element name="detail" type="EventElementDetail"/>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
         <xs:element name="operator-comments" type="EventComments"/>
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: GeoLocation -->
   <xs:complexType name="GeoLocation">
      <xs:sequence>
         <xs:element name="latitude" type="Event-location-coordinates-latitude"/>
         <!-- 3226 -->
         <xs:element name="longitude" type="Event-location-coordinates-longitude"/>
         <!-- 3227 -->
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: LinkLocation -->
   <xs:complexType name="LinkLocation">

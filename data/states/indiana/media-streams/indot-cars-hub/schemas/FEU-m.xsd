   <!-- Descriptive Name: ActivePeriod -->
   <xs:complexType name="ActivePeriod">
      <xs:sequence>
         <xs:element name="period-start-time" type="DateTimeZone"/>
         <xs:element name="period-end-time" type="DateTimeZone"/>
      </xs:sequence>
   </xs:complexType>

   <!-- Descriptive Name: EVENT_Description_text -->
   <xs:simpleType name="Event-description">
      <xs:annotation>
         <xs:documentation>
            Any set of alphanumeric characters up to 2048
         </xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:minLength value="1"/>
         <xs:maxLength value="2048"/>
      </xs:restriction>
   </xs:simpleType>

   <!-- Descriptive Name: Event-description-notes-and-comments -->
   <xs:simpleType name="Event-description-notes-and-comments">
      <xs:annotation>
         <xs:documentation>
            Any set of alphanumeric characters up to 2048
         </xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:minLength value="1"/>
         <xs:maxLength value="2048"/>
      </xs:restriction>
   </xs:simpleType>

   <!-- Descriptive Name: EVENT_DescriptionPriorityLevel_number -->
   <xs:simpleType name="Event-description-priority-level">
      <xs:annotation>
         <xs:documentation>
            where 1 is the Highest Priority and 10 the Lowest Priority
         </xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:unsignedByte">
         <xs:minInclusive value="1"/>
         <xs:maxInclusive value="10"/>
      </xs:restriction>
   </xs:simpleType>

